# AI-Driven Vulnerability Discovery System — Configuration Variables
# Copy to .env and adjust as necessary. Do not commit actual secrets.

# Path to the application root directory (defaults to repository root)
VULN_MVP_ROOT=

# Path to data directory for database and storage (defaults to ./data)
VULN_MVP_DATA=

# Server configuration
HOST=0.0.0.0
PORT=8000

# Optional AI Reasoning Configuration
ENABLE_AI_REASONER=false
AI_PROVIDER=mock
# AI_API_KEY=

